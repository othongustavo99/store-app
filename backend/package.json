{
  "name": "loja-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:check": "node dist/db/check.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run build && npm test",
    "catalog:import": "tsx src/scripts/firebase_catalog_import.ts",
    "privacy:process": "node dist/scripts/process_account_deletions.js",
    "demo:seed": "tsx src/scripts/seed_demo.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.0.0",
    "firebase-admin": "^13.5.0",
    "jose": "^6.0.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
