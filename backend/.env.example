# COPIE para .env APENAS no seu PC. Não envie .env ao Git.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# LOCAL: PostgreSQL em execução. Railway: use referência ao serviço Postgres.
DATABASE_URL=postgresql://postgres:SlLMoSnOPVFPyteOKIbnrtFdYqIJdPwa@autorack.proxy.rlwy.net:33650/railway
# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=COLOQUE_AQUI_UM_SEGREDO_DE_48_BYTES_OU_MAIS_GERADO_ALEATORIAMENTE
JWT_ISSUER=loja-api-local
# Deixe false em produção. True apenas em ambiente de teste controlado.
ALLOW_STORE_SELF_SERVICE=false
PG_POOL_MAX=5
# false: não confiar em cabeçalhos encaminhados de IP sem um proxy conhecido
TRUST_PROXY=false

# Fase 5.4: verifique o domínio remetente no provedor antes de ativar.
# RESEND_API_KEY=
# ACCOUNT_EMAIL_FROM=Loja <contas@seudominio.com.br>
# PUBLIC_BASE_URL=https://sua-api.up.railway.app

# P0: acesso de visitante demo de um clique SOMENTE em loja com stores.is_demo=true.
ENABLE_PUBLIC_DEMO_LOGIN=false

# P2 opcional: credencial Firebase service account JSON codificada em base64 (Railway secret).
# NUNCA incluir seu valor em Git, ZIP, aplicativo ou --dart-define.
# FCM_SERVICE_ACCOUNT_JSON_BASE64=
